# =============================================
# DELICACY - Variáveis de Ambiente
# =============================================
# ATENÇÃO: Este arquivo contém dados sensíveis.
# Nunca commitar no repositório Git.
# Copie este arquivo para .env e preencha os valores.
# =============================================

# === Ambiente da Aplicação ===
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=GERAR_UMA_CHAVE_ALEATORIA_AQUI

# === Banco de Dados MySQL ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=delicacy_db
DB_USER=root
DB_PASS=

# === Configurações de Email (MVP) ===
MAIL_FROM=noreply@delicacy.com.br
MAIL_FROM_NAME=Delicacy

# === Timezone ===
APP_TIMEZONE=America/Sao_Paulo
