# =============================================
# DELICACY - Variáveis de Ambiente
# =============================================

# Ambiente
APP_ENV=development
DEBUG_MODE=true

# URL Base
BASE_URL=http://localhost:8000

# =============================================
# Banco de Dados
# =============================================
DB_HOST=localhost
DB_USER=delicacy_user
DB_PASS=UMA_SENHA_FORTE
DB_NAME=delicacy_db
DB_PORT=3306

# =============================================
# Email (futuro)
# =============================================
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@delicacy.com

# =============================================
# Twilio WhatsApp (MVP)
# =============================================
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# =============================================
# Payment Gateway (futuro)
# =============================================
MERCADOPAGO_KEY=
PAGSEGURO_KEY=

# =============================================
# Sessão
# =============================================
SESSION_TIMEOUT=3600
SESSION_NAME=DELICACY_SESSION
